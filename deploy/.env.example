# Copied to the server as .env, chmod 600, and never committed.
#
# The app host holds no state beyond this file: Postgres is managed and lives elsewhere,
# so losing the box costs a redeploy and nothing else.

# --- what the deploy fills in --------------------------------------------------------
OWNER=your-github-username-lowercased
# Overwritten with the deployed commit SHA by scripts/deploy.sh every time a deploy
# succeeds, so this file always says what is running and a plain `docker compose up`
# brings that same image back. `latest` is only the value before the first deploy.
TAG=latest

# --- the site ------------------------------------------------------------------------
DOMAIN=splitledger.example.com
ACME_EMAIL=you@example.com

# --- managed Postgres ----------------------------------------------------------------
DB_URL=jdbc:postgresql://host.neon.tech/neondb?sslmode=require
DB_USER=
DB_PASSWORD=

# At least 32 bytes. No default anywhere: production must fail to start rather than boot
# with a guessable signing key.
JWT_SECRET=

# --- scheduler cadence ----------------------------------------------------------------
# Optional: docker-compose.prod.yml already defaults these to the spaced-out production
# values. Set them here only to deviate, and read the compute-allowance note in
# deploy/README.md first -- the development defaults (every 5s, every minute) keep a
# scale-to-zero database awake around the clock and will exhaust a free monthly
# allowance before the month is out.
# PAYMENTS_POLL_CRON=0 */15 * * * *
# SETTLEMENT_EXPIRY_CRON=0 0 * * * *
# IDEMPOTENCY_PURGE_CRON=0 0 3 * * *

# --- the kill switches ---------------------------------------------------------------
# Off until email verification ships (SL-901). Toggling this needs a restart, not a
# deploy.
REGISTRATION_ENABLED=false
# Off everywhere data is fictional, which is everywhere in this product (ADR-013).
PAYMENTS_UPI_INTENT_ENABLED=false

# --- Razorpay, test mode only -------------------------------------------------------
# Leave both blank and the provider is not created at all: the demo settles through the
# sandbox instead (SL-601). Only ever a test-mode pair -- rzp_test_..., never rzp_live_...
# The id is public and reaches the browser; the secret never leaves the server.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
