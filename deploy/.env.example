# Copied to the server as .env, chmod 600, and never committed.
#
# The app host holds no state beyond this file: Postgres is managed and lives elsewhere,
# so losing the box costs a redeploy and nothing else.

# --- what the deploy fills in --------------------------------------------------------
OWNER=your-github-username-lowercased
TAG=latest

# --- the site ------------------------------------------------------------------------
DOMAIN=splitledger.example.com
ACME_EMAIL=you@example.com

# --- managed Postgres ----------------------------------------------------------------
DB_URL=jdbc:postgresql://host.neon.tech/neondb?sslmode=require
DB_USER=
DB_PASSWORD=

# At least 32 bytes. No default anywhere: production must fail to start rather than boot
# with a guessable signing key.
JWT_SECRET=

# --- the kill switches ---------------------------------------------------------------
# Off until email verification ships (SL-901). Toggling this needs a restart, not a
# deploy.
REGISTRATION_ENABLED=false
# Off everywhere data is fictional, which is everywhere in this product (ADR-013).
PAYMENTS_UPI_INTENT_ENABLED=false
