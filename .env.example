# SplitLedger — copy to .env and fill in. NEVER commit .env.
# Dev data stores are managed free-tier services (ADR-012): nothing runs locally.

# ---- database (managed dev instance — never point this at production) ----
# Neon serverless Postgres (ADR-012). Create the project on Postgres 16: Neon
# offers 14-18, the integration suite runs postgres:16-alpine, and a project's
# major version cannot be changed afterwards. Create a database and a role both
# named splitledger, or edit the two lines below to match what Neon generated
# (neondb / neondb_owner by default).
#
# Take the DIRECT endpoint from the console, not the '-pooler' one: HikariCP is
# already the pool, and stacking PgBouncer in front of it in transaction mode
# would only cost prepared statements.
#
# verify-full, not require: 'require' encrypts without authenticating the
# server, which is Neon's own guidance.
#
# sslfactory is not optional with verify-full. pgjdbc's default factory is
# LibPQFactory, which ignores the JVM trust store and insists on a PEM file at
# ${user.home}/.postgresql/root.crt -- absent on an ordinary machine, so startup
# dies with 'Could not open SSL root certificate file'. DefaultJavaSSLFactory
# uses the JDK trust store, which already carries the ISRG Root X1 that Neon's
# chain terminates at. (libpq's 'sslrootcert=system' has no pgjdbc equivalent.)
# Hostname checking is unaffected: verify-full applies PGjdbcHostnameVerifier
# whichever factory is in play.
# channelBinding=require needs pgjdbc >= 42.7.12 (CVE-2026-54291); Spring Boot
# 4.1.1 resolves 42.7.13, so it is safe here. Drop it if the driver is pinned back.
#
# NOTE the '&': quote this value if you ever `source` this file in a shell.
DB_URL=jdbc:postgresql://ep-<id>.<region>.aws.neon.tech/splitledger?sslmode=verify-full&channelBinding=require&sslfactory=org.postgresql.ssl.DefaultJavaSSLFactory
DB_USER=splitledger
DB_PASSWORD=

# Pool overrides. The defaults in application.yml are sized for Neon's
# five-minute scale-to-zero; a deployment against an always-on Postgres can
# raise them. Rarely needed.
# DB_POOL_MIN_IDLE=
# DB_POOL_IDLE_TIMEOUT=
# DB_POOL_MAX_LIFETIME=
# DB_POOL_MAX_SIZE=

# ---- cache (managed Redis, TLS). Blank selects the in-process Caffeine cache (ADR-015) ----
REDIS_URL=

# Bounds for the in-process cache, which lives in the API's own heap: the defaults in
# application.yml hold 10k groups' balances for the five minutes LLD section 13 allows.
# Raise the size for a bigger instance; shorten the TTL to serve fresher balances at the
# cost of more ledger reads. Both apply to the in-process cache only. Rarely needed.
# CACHE_BAL_MAX_SIZE=
# CACHE_BAL_TTL=

# ---- broker. Blank selects the in-process LocalEventBus (ADR-015) ----
KAFKA_BOOTSTRAP=
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_JAAS_CONFIG=

# ---- mail (Mailtrap in dev; a domain-authenticated provider at launch, SL-902) ----
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@splitledger.local

# ---- auth (ADR-011) ----
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ---- payments: TEST MODE ONLY (ADR-013). No real money moves anywhere. ----
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# UPI intent is the only method that can reach a real bank account. Keep it off
# wherever the expense data is fictional. See ADR-013.
PAYMENTS_UPI_INTENT_ENABLED=false
SANDBOX_AUTOCONFIRM_DELAY=PT5S

# ---- app ----
APP_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Off until email verification ships (SL-901). Lets the app go live in S6 unexposed.
REGISTRATION_ENABLED=false

# ---- deployment host only (not needed locally) ----
# POSTGRES_PASSWORD=   # initialises the Postgres container; set equal to DB_PASSWORD
# OWNER=               # lowercase GHCR owner, used by docker-compose.prod.yml
