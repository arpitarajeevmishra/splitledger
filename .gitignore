# ---- secrets: never commit these ----
.env
.env.*
!.env.example

# ---- internal documentation: kept local, not published ----
# The docs/ tree stays on disk and under active use; it is simply not pushed.
# README.md and .github/**/*.md are deliberately NOT ignored: the former is the
# repository's front page, the latter are functional GitHub templates that stop
# working if they are absent.
docs/
frontend/README.md

# ---- iCloud Drive conflict copies ----
# ~/Documents is iCloud-synced, which silently produced 22 duplicate "Foo 2.java" files.
# `git add -A` committed them and the backend stopped compiling with "duplicate class".
# Ignoring them stops the symptom; moving the project out of ~/Documents stops the cause.
* [0-9].*
*.icloud

# ---- key material: must never be committed ----
# Defence in depth. Publishing a private key is not a recoverable mistake.
*.pem
*.key
*.p12
*.jks
*.ppk
id_rsa*
id_ecdsa*
id_ed25519*
*_rsa
*_ed25519
.ssh/

# ---- Java / Maven ----
target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar
*.log
hs_err_pid*
replay_pid*

# ---- Node ----
node_modules/
dist/
dist-ssr/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# ---- test output ----
coverage/
playwright-report/
test-results/
blob-report/
.playwright/

# ---- editors / OS ----
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# ---- local scratch ----
*.local
.scratch/

# Local Claude Code state: worktrees and the dev-server launch config are this
# machine's, not the project's.
.claude/

# jqwik's failure-replay cache: local state that records which samples failed here.
.jqwik-database
