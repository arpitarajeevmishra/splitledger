# ---- secrets: never commit these ----
.env
.env.*
!.env.example

# ---- key material: must never be committed ----
# Defence in depth. Publishing a private key is not a recoverable mistake.
*.pem
*.key
*.p12
*.jks
*.ppk
id_rsa*
id_ecdsa*
id_ed25519*
*_rsa
*_ed25519
.ssh/

# ---- Java / Maven ----
target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar
*.log
hs_err_pid*
replay_pid*

# ---- Node ----
node_modules/
dist/
dist-ssr/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# ---- test output ----
coverage/
playwright-report/
test-results/
blob-report/
.playwright/

# ---- editors / OS ----
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# ---- local scratch ----
*.local
.scratch/
